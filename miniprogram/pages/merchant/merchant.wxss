.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0 22rpx;
}

.logout-button {
  flex: 0 0 112rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #dcd4ca;
  background: #ffffff;
  color: #5e574f;
  font-size: 24rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #2f5d50;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #6d675f;
  font-size: 25rpx;
  line-height: 1.45;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.metric-label {
  display: block;
  color: #807970;
  font-size: 23rpx;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  color: #2f5d50;
  font-size: 38rpx;
  font-weight: 800;
}

.empty {
  padding: 52rpx 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-copy {
  display: block;
  margin-top: 12rpx;
  color: #807970;
  font-size: 25rpx;
  line-height: 1.5;
}

.order {
  margin-bottom: 22rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.order-id {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.status {
  flex: 0 0 auto;
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #edf5f1;
  color: #2f5d50;
  font-size: 24rpx;
  font-weight: 700;
}

.order-body {
  display: flex;
  gap: 20rpx;
}

.mini-stage {
  position: relative;
  flex: 0 0 190rpx;
  width: 190rpx;
  height: 230rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #faf7f1;
}

.mini-wrap {
  position: absolute;
  left: 43rpx;
  bottom: 15rpx;
  width: 104rpx;
  height: 122rpx;
  border: 2rpx solid rgba(30, 30, 30, 0.08);
  transform: rotate(45deg);
}

.mini-flower {
  position: absolute;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  transform: translate(-50%, -50%);
}

.mini-flower.large {
  width: 40rpx;
  height: 40rpx;
}

.mini-flower.medium {
  width: 34rpx;
  height: 34rpx;
}

.mini-flower.small {
  width: 26rpx;
  height: 26rpx;
}

.mini-core {
  width: 30%;
  height: 30%;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.mini-ribbon {
  position: absolute;
  left: 70rpx;
  bottom: 54rpx;
  z-index: 3;
  width: 54rpx;
  height: 18rpx;
  border-radius: 999rpx;
}

.order-info {
  min-width: 0;
  flex: 1;
}

.order-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.info-line {
  display: block;
  margin-top: 6rpx;
  color: #5e574f;
  font-size: 24rpx;
}

.message {
  display: block;
  margin-top: 12rpx;
  padding: 14rpx;
  border-left: 6rpx solid #2f5d50;
  background: #f4f1ea;
  color: #3a332d;
  font-size: 24rpx;
  line-height: 1.45;
}

.actions {
  display: block;
  margin-top: 20rpx;
}

.action-button {
  width: 100%;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0;
  font-size: 25rpx;
}
