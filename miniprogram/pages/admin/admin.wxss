.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0 22rpx;
}

.logout-button {
  flex: 0 0 112rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #dcd4ca;
  background: #ffffff;
  color: #5e574f;
  font-size: 24rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #2f5d50;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #6d675f;
  font-size: 25rpx;
  line-height: 1.45;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 26rpx;
}

.metric {
  padding: 18rpx 14rpx;
}

.metric-label {
  display: block;
  color: #807970;
  font-size: 22rpx;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  color: #2f5d50;
  font-size: 32rpx;
  font-weight: 800;
}

.empty {
  padding: 44rpx 28rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-copy {
  display: block;
  margin-top: 12rpx;
  color: #807970;
  font-size: 25rpx;
  line-height: 1.5;
}

.card {
  margin-bottom: 20rpx;
}

.order-detail {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 18rpx;
}

.order-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  background: #f4f1ea;
}

.order-copy {
  min-width: 0;
}

.order-name {
  display: block;
  color: #2f2924;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.review-image {
  width: 100%;
  height: 320rpx;
  margin-bottom: 18rpx;
  border-radius: 8rpx;
  background: #f4f1ea;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.card-copy,
.info-line {
  display: block;
  margin-top: 10rpx;
  color: #5e574f;
  font-size: 24rpx;
  line-height: 1.45;
}

.actions {
  display: grid;
  gap: 14rpx;
  margin-top: 18rpx;
}

.actions.two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.action-button {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0;
  font-size: 25rpx;
}

.order-title {
  margin-top: 30rpx;
}

.order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.status {
  flex: 0 0 auto;
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #edf5f1;
  color: #2f5d50;
  font-size: 24rpx;
  font-weight: 700;
}
