.role-login-page {
  padding-top: 72rpx;
}

.brand {
  margin-bottom: 52rpx;
  text-align: center;
}

.brand-logo {
  display: block;
  width: 520rpx;
  height: 150rpx;
  margin: 0 auto;
}

.role-title {
  display: block;
  margin-top: 22rpx;
  color: #2b2b2b;
  font-size: 36rpx;
  font-weight: 800;
}

.login-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e7dfd5;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.login-button {
  height: 82rpx;
}
