<view class="page">
  <view class="topbar">
    <view>
      <text class="eyebrow">用户端</text>
      <text class="title">定制一束刚刚好的花</text>
    </view>
    <button class="logout-button" bindtap="logout">退出</button>
  </view>

  <view class="segmented">
    <view class="segment {{activePanel === 'customize' ? 'active' : ''}}" data-panel="customize" bindtap="switchPanel">定制</view>
    <view class="segment {{activePanel === 'community' ? 'active' : ''}}" data-panel="community" bindtap="switchPanel">社区</view>
    <view class="segment {{activePanel === 'orders' ? 'active' : ''}}" data-panel="orders" bindtap="switchPanel">我的订单</view>
  </view>

  <view wx:if="{{activePanel === 'customize'}}">
    <view class="section">
      <view class="section-title">
        <text>花束预览</text>
      </view>
      <view class="preview-panel">
        <image class="bouquet-image" src="{{previewImage}}" mode="aspectFit"></image>
        <view class="preview-copy">
          <text class="preview-price">¥{{totalPrice}}</text>
          <text class="preview-name">{{selectedPalette.name}} {{selectedFlower.name}}</text>
          <text class="preview-desc">{{selectedScenario.name}} · {{selectedFiller.name}} · {{selectedLayout.name}}</text>
        </view>
      </view>
    </view>

    <view class="section choice-panel">
      <view class="choice-row">
        <button class="cycle-button" bindtap="cycleScenario">
          <text class="cycle-label">送花场景</text>
          <text class="cycle-value">{{selectedScenario.name}}</text>
        </button>
        <button class="cycle-button" bindtap="cyclePalette">
          <text class="cycle-label">色系</text>
          <text class="cycle-value">{{selectedPalette.name}}</text>
        </button>
      </view>
      <view class="choice-row">
        <button class="cycle-button" bindtap="cycleFlower">
          <text class="cycle-label">主花</text>
          <text class="cycle-value">{{selectedFlower.name}}</text>
        </button>
        <button class="cycle-button" bindtap="cycleFiller">
          <text class="cycle-label">副花</text>
          <text class="cycle-value">{{selectedFiller.name}}</text>
        </button>
      </view>
      <view class="choice-row">
        <button class="cycle-button" bindtap="cycleLayout">
          <text class="cycle-label">花束版型</text>
          <text class="cycle-value">{{selectedLayout.name}}</text>
        </button>
        <button class="cycle-button" bindtap="cycleWrapper">
          <text class="cycle-label">包装材质</text>
          <text class="cycle-value">{{selectedWrapper.name}}</text>
        </button>
      </view>
    </view>

    <view class="section panel">
      <view class="section-title"><text>配送与寄语</text></view>
      <view class="field">
        <text class="field-label">配送日期</text>
        <picker mode="date" value="{{deliveryDate}}" bindchange="onDateChange">
          <view class="picker-value">{{deliveryDate}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">配送时段</text>
        <picker mode="selector" range="{{timeSlots}}" value="{{timeSlotIndex}}" bindchange="onTimeSlotChange">
          <view class="picker-value">{{timeSlots[timeSlotIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">配送地址</text>
        <view class="address-row">
          <input class="input address-input" placeholder="请选择或填写详细配送地址" value="{{address}}" bindinput="onAddressInput" />
          <button class="map-button" bindtap="chooseAddress">地图选址</button>
        </view>
        <text wx:if="{{addressError}}" class="field-error">{{addressError}}</text>
      </view>
      <view class="field">
        <text class="field-label">收花人</text>
        <input class="input" placeholder="例如：林小姐" value="{{receiver}}" bindinput="onReceiverInput" />
      </view>
      <view class="field">
        <text class="field-label">联系电话</text>
        <input class="input" type="number" maxlength="11" placeholder="请输入 11 位手机号" value="{{phone}}" bindinput="onPhoneInput" />
        <text wx:if="{{phoneError}}" class="field-error">{{phoneError}}</text>
      </view>
      <view class="field">
        <text class="field-label">寄语</text>
        <textarea class="textarea" maxlength="80" placeholder="写一句想说的话" value="{{message}}" bindinput="onMessageInput"></textarea>
      </view>
      <button class="primary-button" bindtap="submitOrder">微信支付并下单</button>
    </view>
  </view>

  <view wx:if="{{activePanel === 'community'}}">
    <view class="section-title">
      <text>社区晒图</text>
      <text class="muted">平台审核后展示</text>
    </view>
    <view wx:if="{{approvedPosts.length === 0}}" class="empty panel">
      <text class="empty-title">还没有审核通过的晒图</text>
      <text class="empty-copy">完成订单后在“我的订单”申请晒图，平台端审核通过后会出现在这里。</text>
    </view>
    <view wx:for="{{approvedPosts}}" wx:key="id" class="post panel">
      <view class="post-preview">
        <image class="post-image" src="{{item.fullImageUrl}}" mode="aspectFill"></image>
        <view class="post-copy">
          <text class="post-title">{{item.title}}</text>
          <text class="post-desc">{{item.content}}</text>
          <text class="muted">{{item.specs.flower.name}} · {{item.specs.palette.name}} · {{item.approvedAt}}</text>
        </view>
      </view>
      <view class="post-actions">
        <button class="secondary-button action-button {{item.likedByMe ? 'liked' : ''}}" data-id="{{item.id}}" bindtap="likePost">{{item.likedByMe ? '已赞' : '赞'}} {{item.likes}}</button>
        <button class="secondary-button action-button" data-id="{{item.id}}" bindtap="commentPost">评论</button>
      </view>
      <view wx:if="{{item.comments.length > 0}}" class="comments">
        <view wx:for="{{item.comments}}" wx:for-item="comment" wx:key="index" class="comment">{{comment.userName}}：{{comment.content}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{activePanel === 'orders'}}">
    <view class="section-title"><text>我的订单</text></view>
    <view wx:if="{{orders.length === 0}}" class="empty panel">
      <text class="empty-title">还没有订单</text>
      <text class="empty-copy">完成一次下单后，可以在这里跟踪订单并申请晒图。</text>
    </view>
    <view wx:for="{{orders}}" wx:key="id" class="order panel">
      <view class="order-top">
        <view>
          <text class="order-id">{{item.id}}</text>
          <text class="muted">{{item.deliveryTime}}</text>
        </view>
        <text class="status">{{item.status}}</text>
      </view>
      <text class="order-name">{{item.specs.palette.name}} {{item.specs.flower.name}} · ¥{{item.totalPrice}}</text>
      <text class="info-line">地址：{{item.address}}</text>
      <text class="info-line">寄语：{{item.message}}</text>
      <text class="info-line">支付：{{item.paymentStatus}}</text>
      <text class="info-line">结算：{{item.settlementStatus}}</text>
      <button wx:if="{{item.canConfirmReceipt}}" class="primary-button compact" data-id="{{item.id}}" bindtap="confirmReceipt">已收到</button>
      <button wx:if="{{item.canShare}}" class="primary-button compact" data-id="{{item.id}}" bindtap="requestPostReview">申请晒图审核</button>
      <button wx:elif="{{item.postStatusText}}" class="secondary-button compact" disabled>{{item.postStatusText}}</button>
    </view>
  </view>
</view>
