.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0 20rpx;
}

.logout-button {
  flex: 0 0 112rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #dcd4ca;
  background: #ffffff;
  color: #5e574f;
  font-size: 24rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #2f5d50;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 800;
}

.segmented {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-bottom: 28rpx;
  padding: 8rpx;
  border: 1rpx solid #e7dfd5;
  border-radius: 8rpx;
  background: #ffffff;
}

.segment {
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 6rpx;
  color: #6d675f;
  font-size: 26rpx;
  text-align: center;
}

.segment.active {
  background: #2f5d50;
  color: #ffffff;
  font-weight: 700;
}

.summary-row {
  display: grid;
  grid-template-columns: 220rpx 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat {
  min-height: 110rpx;
}

.stat-label {
  display: block;
  color: #807970;
  font-size: 23rpx;
}

.stat-value {
  display: block;
  margin-top: 8rpx;
  color: #2f5d50;
  font-size: 36rpx;
  font-weight: 800;
}

.stat-value.small {
  font-size: 28rpx;
}

.preview-panel,
.post-preview {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #ebe5dc;
  border-radius: 8rpx;
  background: #fffefa;
}

.bouquet-stage {
  position: relative;
  flex: 0 0 260rpx;
  width: 260rpx;
  height: 300rpx;
  overflow: hidden;
}

.bouquet-image {
  flex: 0 0 260rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 8rpx;
  background: #fffaf4;
}

.fallback-stage {
  display: none;
}

.wrap {
  position: absolute;
  left: 39rpx;
  bottom: 8rpx;
  width: 182rpx;
  height: 188rpx;
  border: 2rpx solid rgba(30, 30, 30, 0.08);
  transform: rotate(45deg);
}

.wrap-kraft {
  background-image: linear-gradient(135deg, rgba(90, 65, 35, 0.12) 25%, transparent 25%, transparent 50%, rgba(90, 65, 35, 0.12) 50%, rgba(90, 65, 35, 0.12) 75%, transparent 75%);
  background-size: 18rpx 18rpx;
}

.wrap-mesh {
  background-image: linear-gradient(45deg, rgba(255, 255, 255, 0.38) 25%, transparent 25%), linear-gradient(-45deg, rgba(255, 255, 255, 0.38) 25%, transparent 25%);
  background-size: 16rpx 16rpx;
}

.wrap-premium {
  box-shadow: inset 0 0 0 8rpx rgba(255, 255, 255, 0.28);
}

.wrap-fold {
  position: absolute;
  left: 86rpx;
  bottom: 18rpx;
  width: 88rpx;
  height: 150rpx;
  border-left: 2rpx solid rgba(0, 0, 0, 0.08);
  border-right: 2rpx solid rgba(255, 255, 255, 0.5);
}

.flower-dot,
.mini-flower {
  position: absolute;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 5rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(44, 31, 27, 0.12);
  transform: translate(-50%, -50%);
}

.flower-dot.large {
  width: 58rpx;
  height: 58rpx;
}

.flower-dot.medium {
  width: 48rpx;
  height: 48rpx;
}

.flower-dot.small {
  width: 36rpx;
  height: 36rpx;
}

.flower-core,
.mini-core {
  width: 32%;
  height: 32%;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.ribbon {
  position: absolute;
  left: 94rpx;
  bottom: 58rpx;
  z-index: 3;
  width: 76rpx;
  height: 24rpx;
  border-radius: 999rpx;
}

.preview-copy,
.post-copy {
  min-width: 0;
  flex: 1;
}

.preview-name,
.post-title,
.order-name {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
}

.preview-desc,
.post-desc {
  display: block;
  margin: 10rpx 0;
  color: #6d675f;
  font-size: 25rpx;
  line-height: 1.4;
}

.palette-row {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
}

.palette {
  flex: 0 0 150rpx;
  padding: 16rpx;
  border: 1rpx solid #e7dfd5;
  border-radius: 8rpx;
  background: #ffffff;
  color: #5e574f;
  font-size: 24rpx;
}

.palette.active {
  border-color: #2f5d50;
  background: #edf5f1;
}

.swatches {
  display: flex;
  margin-bottom: 12rpx;
}

.swatch {
  width: 38rpx;
  height: 38rpx;
  margin-right: -8rpx;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
}

.field {
  margin-bottom: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #5e574f;
  font-size: 24rpx;
  font-weight: 700;
}

.picker-value,
.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #e7dfd5;
  border-radius: 8rpx;
  background: #fffefa;
  font-size: 28rpx;
}

.picker-value,
.input {
  height: 82rpx;
  line-height: 82rpx;
  padding: 0 18rpx;
}

.textarea {
  min-height: 140rpx;
  padding: 18rpx;
  line-height: 1.5;
}

.empty {
  padding: 52rpx 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-copy {
  display: block;
  margin-top: 12rpx;
  color: #807970;
  font-size: 25rpx;
  line-height: 1.5;
}

.post,
.order {
  margin-bottom: 22rpx;
}

.post-image {
  flex: 0 0 190rpx;
  width: 190rpx;
  height: 230rpx;
  border-radius: 8rpx;
  background: #f4f1ea;
}

.mini-stage {
  position: relative;
  flex: 0 0 190rpx;
  width: 190rpx;
  height: 230rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #faf7f1;
}

.mini-wrap {
  position: absolute;
  left: 43rpx;
  bottom: 15rpx;
  width: 104rpx;
  height: 122rpx;
  border: 2rpx solid rgba(30, 30, 30, 0.08);
  transform: rotate(45deg);
}

.mini-flower {
  border-width: 4rpx;
}

.mini-flower.large {
  width: 40rpx;
  height: 40rpx;
}

.mini-flower.medium {
  width: 34rpx;
  height: 34rpx;
}

.mini-flower.small {
  width: 26rpx;
  height: 26rpx;
}

.mini-ribbon {
  position: absolute;
  left: 70rpx;
  bottom: 54rpx;
  z-index: 3;
  width: 54rpx;
  height: 18rpx;
  border-radius: 999rpx;
}

.post-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-button,
.compact {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0;
  font-size: 25rpx;
}

.action-button.liked {
  background: #edf5f1;
  color: #2f5d50;
  font-weight: 700;
}

.comments {
  margin-top: 16rpx;
}

.comment {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #f4f1ea;
  color: #5e574f;
  font-size: 24rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.order-id {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.status {
  flex: 0 0 auto;
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #edf5f1;
  color: #2f5d50;
  font-size: 24rpx;
  font-weight: 700;
}

.info-line {
  display: block;
  margin: 10rpx 0 16rpx;
  color: #5e574f;
  font-size: 24rpx;
}
