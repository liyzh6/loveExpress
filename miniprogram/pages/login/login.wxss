.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: 72rpx;
}

.brand {
  margin-bottom: 52rpx;
  text-align: center;
}

.brand-logo {
  display: block;
  width: 520rpx;
  height: 150rpx;
  margin: 0 auto;
}

.slogan {
  display: block;
  margin-top: 22rpx;
  color: #2b2b2b;
  font-size: 32rpx;
  font-weight: 700;
}

.login-panel {
  margin-top: 8rpx;
}

.login-button {
  height: 82rpx;
  line-height: normal;
  margin-top: 0;
  padding: 0;
}

.role-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-top: auto;
  padding-bottom: 46rpx;
}

.role-link,
.role-divider {
  color: #6d675f;
  font-size: 24rpx;
}
